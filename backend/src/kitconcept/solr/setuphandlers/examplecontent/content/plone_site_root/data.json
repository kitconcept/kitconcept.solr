        "73db67db-4c7b-5b13-ab10-bc58cbecc2b2": {
          "@type": "teaser",
          "description": "Die Personalabteilung des IAZ informiert \u00fcber die aktualisierte Dienstvereinbarung zum mobilen Arbeiten. Ab 1. Juli gelten neue Regelungen zur Homeoffice-Nutzung und technischen Ausstattung.",
          "href": [
            {
              "@id": "../resolveuid/ed622e194da44a319d9caa501a5d4684",
              "title": "Neue Dienstvereinbarung zum mobilen Arbeiten"
            }
          ],
